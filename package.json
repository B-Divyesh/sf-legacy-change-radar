{
  "name": "legacy-change-radar-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run build:site",
    "build:site": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "npm run test:rust && npm run test:site && npm run test:e2e",
    "test:rust": "cargo test",
    "test:site": "npm run build:site && node --test tests/site.unit.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "22.12.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
